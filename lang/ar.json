    "about.story_title": "\u0642\u0635\u062a\u0646\u0627",
    "about.story_body": "\u0628\u062f\u0623\u0646\u0627 \u0628\u0641\u0643\u0631\u0629 \u0628\u0633\u064a\u0637\u0629: \u0628\u0646\u0627\u0621 \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0631\u0627\u0626\u0639\u0629 \u062a\u062d\u0644 \u0645\u0634\u0627\u0643\u0644 \u062d\u0642\u064a\u0642\u064a\u0629. \u0639\u0644\u0649 \u0645\u0631 \u0627\u0644\u0633\u0646\u064a\u0646\u060c \u0646\u0645\u0648\u0646\u0627 \u0644\u0646\u0635\u0628\u062d \u0641\u0631\u064a\u0642\u064b\u0627 \u0645\u0646 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0627\u0644\u0645\u062a\u062d\u0645\u0633\u064a\u0646 \u0644\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0648\u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631.",
    "about.mission_title": "\u0645\u0647\u0645\u062a\u0646\u0627",
    "about.mission_body": "\u062a\u0642\u062f\u064a\u0645 \u062d\u0644\u0648\u0644 \u0631\u0642\u0645\u064a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0637\u0648\u064a\u0631 \u062a\u0633\u0627\u0639\u062f \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0627\u0632\u062f\u0647\u0627\u0631 \u0641\u064a \u0645\u0634\u0647\u062f \u0631\u0642\u0645\u064a \u0645\u062a\u0637\u0648\u0631 \u0628\u0627\u0633\u062a\u0645\u0631\u0627\u0631.",
